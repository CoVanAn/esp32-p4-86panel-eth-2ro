# SDKCONFIG defaults to set SDIO pins for esp_hosted / SDIO Wi-Fi
# NOTE: Kconfig option names depend on the component's Kconfig implementation.
# If these keys do not match the upstream component, adjust them to the
# option names provided by the component (check its Kconfig files).

# Common pattern used by components is CONFIG_<COMPONENT>_SDIO_<SIGNAL>_PIN
CONFIG_ESP_HOSTED_SDIO_CLK_PIN=43
CONFIG_ESP_HOSTED_SDIO_CMD_PIN=44
CONFIG_ESP_HOSTED_SDIO_D0_PIN=39
CONFIG_ESP_HOSTED_SDIO_D1_PIN=40
CONFIG_ESP_HOSTED_SDIO_D2_PIN=41
CONFIG_ESP_HOSTED_SDIO_D3_PIN=42

# Alternative names sometimes used; uncomment if the component expects these
#CONFIG_ESP_WIFI_REMOTE_SDIO_CLK_PIN=43
#CONFIG_ESP_WIFI_REMOTE_SDIO_CMD_PIN=44
#CONFIG_ESP_WIFI_REMOTE_SDIO_D0_PIN=39
#CONFIG_ESP_WIFI_REMOTE_SDIO_D1_PIN=40
#CONFIG_ESP_WIFI_REMOTE_SDIO_D2_PIN=41
#CONFIG_ESP_WIFI_REMOTE_SDIO_D3_PIN=42

CONFIG_FREERTOS_HZ=1000

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Enable PSRAM for LCD Framebuffer
CONFIG_SPIRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Increase main task stack size for LVGL and Arduino
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
